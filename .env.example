# ==========================================================
# PhotoFacility — configurazione (Fase 1)
# Copia in .env e compila. NON committare il .env reale.
# ==========================================================

# --- AWS S3 (obbligatori) ---
S3_BUCKET=il-tuo-bucket
S3_REGION=eu-south-1
# prefisso opzionale dentro il bucket (es. "canon" -> canon/2026/07/24/...)
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# solo se usi credenziali temporanee STS
AWS_SESSION_TOKEN=

# --- Endpoint S3-compatibili (opzionale: MinIO, Wasabi, ecc.) ---
# S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com
# S3_PATH_STYLE=false

# --- Percorsi (default sensati; sovrascrivi se necessario) ---
# STAGING_DIR=/percorso/assoluto/staging
# INCOMING_DIR=  # dove la Canon deposita via FTP
# PROCESSING_DIR=
# FAILED_DIR=
# DB_PATH=/percorso/assoluto/db/photofacility.sqlite
# LOG_FILE=/percorso/assoluto/db/photofacility.log
# LOCK_FILE=/percorso/assoluto/db/ingest.lock

# --- Comportamento ingestion ---
# secondi di stabilità mtime prima di considerare completo un upload FTP
QUIESCENCE_SECONDS=20
# budget di tempo per singolo tick (stai sotto al max_execution_time dell'host)
MAX_RUNTIME_SECONDS=50
# quante foto caricare su S3 per tick
UPLOAD_BATCH_SIZE=20
# tentativi prima della quarantena
MAX_UPLOAD_ATTEMPTS=8
RETRY_BASE_BACKOFF=30
RETRY_MAX_BACKOFF=3600
# cancella il file locale dopo conferma S3 (consigliato su hosting con quota)
DELETE_AFTER_UPLOAD=true
# ore di conservazione dei file in failed/ prima della pulizia
STAGING_RETENTION_HOURS=48

# --- Solo se usi l'endpoint web public/cron.php ---
CRON_TOKEN=

# --- Debug ---
DEBUG=false
