# ==========================================================
# PhotoFacility — configurazione (Fase 1)
# Copia in .env e compila. NON committare il .env reale.
# I commenti inline (dopo " #") sono ammessi e vengono ignorati.
# ==========================================================

# --- AWS S3 (obbligatori per l'upload; NON per migrare il DB) ---
S3_BUCKET=il-tuo-bucket
S3_REGION=eu-south-1
S3_PREFIX=                       # prefisso opzionale (es. "canon")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=               # solo con credenziali temporanee STS

# --- Endpoint S3-compatibili (opzionale: MinIO, Wasabi, ecc.) ---
# S3_ENDPOINT=https://s3.eu-central-1.wasabisys.com
# S3_PATH_STYLE=false

# --- Fuso orario "di casa" (raggruppamento per giorno / Fase 2) ---
# I timestamp macchina restano UTC; solo partition_date usa questo fuso.
TIMEZONE=Europe/Rome

# --- Percorsi (default sensati; sovrascrivi se necessario) ---
# STAGING_DIR=/percorso/assoluto/staging
# INCOMING_DIR=                  # dove la Canon deposita via FTP
# DB_PATH=/percorso/assoluto/db/photofacility.sqlite
# LOG_FILE=/percorso/assoluto/db/photofacility.log
# LOCK_FILE=/percorso/assoluto/db/ingest.lock
# HEALTH_FILE=/percorso/assoluto/db/health.json

# --- Ingestion / loop ---
QUIESCENCE_SECONDS=30            # stabilità mtime prima di considerare completo un file
LOOP_DURATION_SECONDS=55         # durata del loop-within-cron (sotto il minuto)
MAX_RUNTIME_SECONDS=55           # budget del singolo tick (endpoint web)
UPLOAD_BATCH_SIZE=20             # foto caricate su S3 per passaggio
DELETE_AFTER_UPLOAD=true         # cancella il file locale dopo conferma S3

# --- Retry / resilienza ---
MAX_UPLOAD_ATTEMPTS=8
RETRY_BASE_BACKOFF=30
RETRY_MAX_BACKOFF=3600
REAPER_STUCK_MINUTES=10          # recupero record bloccati in UPLOADING_S3
DISK_MIN_FREE_MB=1024            # sotto questa soglia: stop ingestione, solo drain
STAGING_RETENTION_HOURS=48       # pulizia file in failed/ e orfani
EVENTS_RETENTION_DAYS=90         # pruning ingest_events (via bin/maintain.php)

# --- Alerting / osservabilità (opzionali) ---
# Webhook: Slack/Discord/Telegram-bot/endpoint proprio. Se vuoto, gli alert
# restano solo nel log. È l'unico modo di accorgersi dei guasti senza SSH.
ALERT_WEBHOOK_URL=
ALERT_EMAIL=                     # fallback via mail() (spesso non attivo su Lightsail)
BACKLOG_ALERT_THRESHOLD=200      # alert se PENDING_S3 supera questo numero
BACKLOG_AGE_ALERT_MINUTES=30     # alert se la foto più vecchia in coda supera questi minuti
STAGING_ALERT_MB=5120            # alert se lo staging locale supera questi MB

# --- Debug ---
DEBUG=false
