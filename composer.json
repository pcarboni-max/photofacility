{
    "name": "industree/photofacility",
    "description": "Ingestion automatica di fotografie Canon EOS via FTP verso AWS S3 (Fase 1).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-curl": "*",
        "ext-hash": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "suggest": {
        "ext-exif": "Estrazione della data di scatto e del modello camera dai metadati EXIF."
    },
    "autoload": {
        "psr-4": {
            "PhotoFacility\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhotoFacility\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "ingest": "php bin/ingest.php",
        "stan": "phpstan analyse src --level=6",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
